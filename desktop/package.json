{
  "name": "keek-desktop",
  "productName": "KEEK",
  "version": "1.0.0",
  "description": "KEEK meeting intelligence — records system audio + microphone, transcribes and analyses meetings with free Groq and Gemini APIs.",
  "main": "src/main.js",
  "private": true,
  "author": "KEEK",
  "homepage": "https://github.com/MohandMahmoud/keek-suite",
  "license": "UNLICENSED",
  "scripts": {
    "sync": "node ../tools/sync.mjs",
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test ../shared/nlp/keek-nlp.test.js test/main-modules.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.keek.desktop",
    "productName": "KEEK",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**", "renderer/**", "package.json"],
    "publish": null,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "artifactName": "KEEK-mac.${ext}",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "KEEK records your microphone during meetings you choose to record.",
        "NSAudioCaptureUsageDescription": "KEEK records computer audio during meetings you choose to record."
      }
    },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "KEEK", "artifactName": "KEEK-Setup.${ext}" },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }, { "target": "deb", "arch": ["x64"] }],
      "category": "Office", "icon": "build/icon.png", "executableName": "keek", "maintainer": "KEEK", "synopsis": "Meeting recorder and AI notes"
    },
    "appImage": { "artifactName": "KEEK-linux.AppImage" },
    "deb": { "artifactName": "KEEK-linux.deb" }
  }
}
